{
  "name": "donde-comemos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --test tests/worker.test.mjs",
    "check": "node --check worker/index.js && node --check public/app.js",
    "build": "wrangler deploy --dry-run --outdir .worker-build",
    "db:local": "wrangler d1 migrations apply comemos --local",
    "db:remote": "wrangler d1 migrations apply comemos --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
