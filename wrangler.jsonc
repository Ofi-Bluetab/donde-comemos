{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donde-comemos",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comemos",
      "database_id": "a5c89ebb-010b-4d92-bd02-647d806f510a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_EMAILS": ""
  }
}
