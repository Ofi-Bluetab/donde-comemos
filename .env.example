# Archivo orientativo: el servidor lee variables del entorno, no este archivo.
COMEMOS_DB=/var/lib/comemos/comemos.sqlite3
COMEMOS_BACKUP_DIR=/var/lib/comemos/backups
COMEMOS_ALLOWED_EMAILS=persona1@empresa.example,persona2@empresa.example
COMEMOS_TLS_CERT=/run/secrets/comemos-cert.pem
COMEMOS_TLS_KEY=/run/secrets/comemos-key.pem
# Render usa HTTPS gestionado; no necesita los dos archivos TLS anteriores.
# El origen se obtiene de RENDER_EXTERNAL_HOSTNAME; indicar este si se usa dominio propio.
# COMEMOS_PUBLIC_ORIGIN=https://comemos.example.com
# COMEMOS_REGISTRATION_CODE=codigo-de-invitacion-largo-configurado-en-el-alojamiento
